{
  "name": "@powerhousedao/example-external-feed-ingest",
  "version": "0.0.0",
  "description": "Example: a polling worker ingests an external feed into a ledger document idempotently — dedup set and high-watermark seeded from document state, corrections modeled as explicit supersede operations",
  "license": "AGPL-3.0-only",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "start": "node --import tsx src/demo.ts",
    "generate": "ph-cli generate document-model --document document-models/feed-ledger/feed-ledger.json"
  },
  "dependencies": {
    "@powerhousedao/reactor": "catalog:",
    "@powerhousedao/reactor-browser": "catalog:",
    "@powerhousedao/shared": "catalog:",
    "document-model": "catalog:",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@powerhousedao/ph-cli": "catalog:",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "vitest": "^4.1.0"
  }
}
